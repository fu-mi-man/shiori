                  "type": "text",
                  "id": "KM9OP",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "しおり作成時にユーザーが入力した情報（タイトル・行程など）は、サービス提供のためにデータベースに保存されます。",
                  "lineHeight": 1.7,
                  "textAlign": "justify",
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
