                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "本サービスはアカウント登録を必要とせず，氏名・メールアドレス・電話番号などの個人を特定できる情報は収集しません。",
                  "lineHeight": 1.7,
                  "textAlign": "justify",
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
